{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.sergii-ziborov/weavatrix",
  "title": "Weavatrix",
  "description": "Native Weavatrix MCP: 42 read-only repository tools across 24 code and configuration surfaces.",
  "repository": {
    "url": "https://github.com/sergii-ziborov/weavatrix",
    "source": "github"
  },
  "version": "1.5.0",
  "websiteUrl": "https://weavatrix.com",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "weavatrix",
      "version": "1.5.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "valueHint": "repoRoot",
          "description": "Absolute path to the initial local repository; defaults to the current directory",
          "format": "filepath",
          "default": ".",
          "isRequired": false
        }
      ]
    }
  ]
}
